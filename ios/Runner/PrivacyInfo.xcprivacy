<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required by App Store Connect. Plugins declare their own manifests;
	     this one covers the app target itself.

	     Nothing is collected because nothing leaves the device: speech is
	     transcribed and translated by an on-device model, and the recording is
	     deleted as soon as it has been read. The single network request the app
	     ever makes is the one-time model download.

	     No required-reason API categories are declared: the app's own code
	     reads and deletes files it created but never reads file timestamps,
	     queries disk space, or touches active keyboards. UserDefaults access
	     comes via shared_preferences, which ships its own manifest. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
